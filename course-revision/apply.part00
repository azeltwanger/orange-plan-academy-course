#!/usr/bin/env python3
"""Apply the August 2026 onboarding/Build Your Plan course revision.

This is a one-time migration. It preserves the ten-module order and lesson
numbers while aligning the scripts, walkthroughs, student text, checkpoints,
and generated production files to the short onboarding + Build Your Plan flow.
"""
from __future__ import annotations

import json
import re
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
REV = Path(__file__).resolve().parent
REPORT = ROOT / "COURSE-LIFECYCLE-REVISION-REPORT.md"
BUNDLE: dict[str, str] = {}
for bundle_path in sorted(REV.glob("bundle-*.json")):
    BUNDLE.update(json.loads(bundle_path.read_text(encoding="utf-8")))


def read(path: Path) -> str:
    return path.read_text(encoding="utf-8")


def write(path: Path, text: str) -> None:
    path.write_text(text.rstrip() + "\n", encoding="utf-8")


def source(name: str) -> str:
    if name not in BUNDLE:
        raise RuntimeError(f"Missing revision source: {name}")
    return BUNDLE[name].strip()


def glob_one(pattern: str) -> Path:
    matches = sorted(ROOT.glob(pattern))
    if len(matches) != 1:
        raise RuntimeError(f"{pattern}: expected one file, found {len(matches)}: {matches}")
    return matches[0]


def lesson_pattern(number: str) -> re.Pattern[str]:
    return re.compile(
        rf"(?ms)^## {re.escape(number)} [^\n]*\n.*?(?=^## A?\d+\.\d+ |^# Unit \d+ |^<!-- ADVANCED-GATE:START -->|\Z)"
    )


def replace_lesson(text: str, number: str, replacement: str) -> str:
    pattern = lesson_pattern(number)
    matches = list(pattern.finditer(text))
    if len(matches) != 1:
        raise RuntimeError(f"lesson {number}: expected one match, found {len(matches)}")
    match = matches[0]
    return text[: match.start()] + replacement.rstrip() + "\n\n" + text[match.end() :]


def edit_lesson(text: str, number: str, editor) -> str:
    pattern = lesson_pattern(number)
    matches = list(pattern.finditer(text))
    if len(matches) != 1:
        raise RuntimeError(f"lesson {number}: expected one match, found {len(matches)}")
    match = matches[0]
    section = editor(match.group(0))
    return text[: match.start()] + section.rstrip() + "\n\n" + text[match.end() :]


def replace_checkpoint(text: str, module: int, replacement: str) -> str:
    pattern = re.compile(
        rf"(?ms)^## Module {module} — [^\n]*\n.*?(?=^## Module \d+ — |^## The whole course is done when|\Z)"
    )
    matches = list(pattern.finditer(text))
    if len(matches) != 1:
        raise RuntimeError(f"checkpoint {module}: expected one match, found {len(matches)}")
    match = matches[0]
    return text[: match.start()] + replacement.rstrip() + "\n\n" + text[match.end() :]


def replace_if_present(text: str, old: str, new: str) -> str:
    return text.replace(old, new) if old in text else text


def insert_before(text: str, marker: str, addition: str, tag: str) -> str:
    if tag in text:
        return text
    if marker not in text:
        return text.rstrip() + "\n\n" + addition.strip() + "\n"
    return text.replace(marker, addition.strip() + "\n\n" + marker, 1)


def insert_after_heading(text: str, addition: str, tag: str) -> str:
    if tag in text:
        return text
    lines = text.splitlines()
    index = 1 if lines and lines[0].startswith("# ") else 0
    lines[index:index] = ["", tag, "", addition.strip(), ""]
    return "\n".join(lines)


def patch_orientation(text: str) -> str:
    replacements = {
        # Master/student-text wording.
        "1. **Module 1: Baseline.** Your numbers, your assumptions, and your first confidence read.":
            "1. **Module 1: Foundation.** Replace the rough onboarding estimate with your real personal details, accounts, holdings, and assumptions.",
        "7. **Module 9: how you keep it alive**, about five minutes a month, plus scenarios and reading your finished plan.":
            "7. **Module 9: run, test, and maintain the finished plan** — the first full confidence check, scenarios, the yearly report, and the five-minute monthly rhythm.",
        "Each module has two kinds of lessons. Teach lessons explain the concept with a real worked example. Walkthroughs put it into the app step by step.":
            "Each module has two kinds of lessons. Teach lessons explain the concept and help you make the decision. Walkthroughs put that decision into the app step by step. Build Your Plan is the checklist that shows whether the underlying data is actually complete.",
        "Build the plan this week with numbers that are approximately right, then refine them as you go. Every lesson is finishable in one sitting so the plan actually gets built.":
            "Onboarding gets a rough estimate on screen quickly. Then each module replaces the rough part it owns with real data and a real decision. Every lesson is finishable in one sitting so the plan actually gets built.",
        "Don't try to be optimal before you're accurate. The most common failure mode is spending three months reconstructing exact cost basis before running the first confidence check. Get the plan standing first. Refine after.":
            "Don't try to be optimal before you're accurate. The most common failure mode is spending three months reconstructing exact cost basis before the rest of the plan exists. Get each area standing in order. The first full confidence check comes after the build, in Module 9.",
        "Rough is fine. Module 1 walks you through gathering them accurately.":
            "Rough is fine for onboarding. Module 1 replaces the account estimate with real Foundation data, and the later modules enter the income, spending, debt, tax, and retirement details where they belong.",
        # Protected 0.1 script wording.
        "1. You're going to start with your baseline numbers and your assumptions about getting the baseline of your plan with all of your numbers in the app.":
            "1. You're going to start by replacing the rough onboarding estimate with your real personal details, accounts, and holdings.",
        "2. You'll set your return assumptions and assumptions about the future.":
            "2. You'll review the return, inflation, and other assumptions the first estimate used.",
        "3. You'll get your first confidence read on where you're at today, when you can retire, and the level of confidence we can have in that plan.":
            "3. You'll learn how to read the retirement date and confidence number, but the first full confidence run happens after the plan is built in Module 9.",
        "9. How you keep the whole thing alive and active, which is going to take you around five minutes every month with one annual review every year, plus how to run scenarios to test a decision before you make it, and how to read your finished plan.":
            "9. How you finish and run the full plan, then keep it alive in around five minutes every month with one annual review, scenarios, and a yearly report.",
    }
    for old, new in replacements.items():
        text = replace_if_present(text, old, new)

    anchor = "Go in order the first time. After that, come back to any lesson as your life changes."
    addition = (
        "\n\nOrange Plan's onboarding is intentionally short. It gives you a starting retirement estimate "
        "from a few rough numbers. It does not build the full plan. After onboarding, open **Build Your Plan**. "
        "Each course module completes the matching area, and the first full confidence check happens after those areas are built."
    )
    if anchor in text and "Orange Plan's onboarding is intentionally short" not in text:
        text = text.replace(anchor, anchor + addition, 1)

    script_anchor = (
        "Each module is going to cover two different types of lessons:\n\n"
        "1. A teach lesson like this one, where I'm just talking to the camera and explaining concepts to you. I'm going to include real-world examples to help make these concepts easier for you to understand.\n"
        "2. A walkthrough of me sharing my screen in the app, walking you through how to implement the things that you're learning step by step in your own financial plan."
    )
    script_addition = (
        script_anchor
        + "\n\nBuild Your Plan is the checklist underneath both of them. The lesson helps you make the decision, "
        "the walkthrough shows you where it goes, and the task completes when the real data exists in the app."
    )
    if script_anchor in text and "Build Your Plan is the checklist underneath both of them" not in text:
        text = text.replace(script_anchor, script_addition, 1)
    return text


def append_handoff(section: str, block: str, tag: str) -> str:
    if tag in section:
        return section
    marker = "### What good looks like"
    if marker in section:
        return section.replace(marker, block.strip() + "\n\n" + marker, 1)
    marker = "### Handing it off"
    if marker in section:
        return section.replace(marker, block.strip() + "\n\n" + marker, 1)
    return section.rstrip() + "\n\n" + block.strip() + "\n"


