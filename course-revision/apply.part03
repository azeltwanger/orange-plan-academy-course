- Onboarding gives a rough deterministic starting age. It does not create the verified baseline or a Monte Carlo confidence score.
- Teaching lessons make the decision. Walkthroughs perform the data entry and application. Build Your Plan is the completion source of truth.
- Foundation enters only personal details, real accounts, current holdings, and the assumptions review.
- Income, spending, reserve and life events belong to Module 2; debts to Module 3; historical transactions and basis to Module 5; retirement spending, Social Security and withdrawal order to Module 6; Protect completion to Module 8.
- The first full 1,000-run confidence check and confidence target belong to Module 9 after the plan is built.
- Lessons 1.4 and 1.5 remain two published lessons from one continuous recording. No module-order or lesson-number overhaul.
- Austin's 2026-08-25 dictation is the authority for the revised 1.1 and 1.2 scripts. The 4% inflation example was mechanically corrected to about $144,000 after 15 years; the dictated $105,000 was an arithmetic error.

"""
        marker = "## Where the project is"
        text = text.replace(marker, addition + marker, 1) if marker in text else addition + text
    write(path, text)


def patch_advanced() -> None:
    path = ROOT / "MASTER-ADVANCED.md"
    text = read(path)
    text = replace_if_present(
        text,
        "If your number is stable and nobody is auditing it, core 1.3 already taught you to *read* it and your plan is complete without this.",
        "If your final Module 9 confidence result is stable and nobody is auditing the model, core 1.3 already taught you how to *read* it and your plan is complete without this.",
    )
    write(path, text)


def patch_usability_test() -> None:
    path = ROOT / "USABILITY-TEST-M1-M3.md"
    text = read(path)
    text = replace_if_present(
        text,
        '| 2 | "Get your real numbers into Orange Plan." | Baseline entered; totals match what they\'d say out loud |',
        '| 2 | "Replace the rough estimate with your real accounts and holdings." | Foundation complete; personal details, accounts, and holdings match reality |',
    )
    text = replace_if_present(
        text,
        '| 4 | "Read your retirement date and your confidence number, and tell me what they mean together." | Both read as a pair; they say the first read is provisional |',
        '| 4 | "Explain the retirement age onboarding showed you, and tell me when the real confidence check happens." | They call the age a rough deterministic estimate and place the 1,000-run check in Module 9 |',
    )
    text = replace_if_present(
        text,
        "- **1.3** introduced \"withdrawal order\" four modules before it is taught. It was\n  in a paragraph added during the previous pass, which is how new jargon gets in.",
        "- **1.3** now separates the rough onboarding age from the finished-plan confidence result, so testers are not asked to read precision the short onboarding no longer produces.",
    )
    write(path, text)


def run_required(label: str, command: list[str], log: list[str]) -> None:
    proc = subprocess.run(command, cwd=ROOT, text=True, capture_output=True)
    output = (proc.stdout + proc.stderr).strip()
    log += [f"### {'PASS' if proc.returncode == 0 else 'FAIL'} · {label}", "", "```text", output[-5000:] or "(no output)", "```", ""]
    if proc.returncode != 0:
        raise RuntimeError(f"{label} failed\n{output}")


def run_check(label: str, command: list[str], log: list[str]) -> int:
    proc = subprocess.run(command, cwd=ROOT, text=True, capture_output=True)
    output = (proc.stdout + proc.stderr).strip()
    log += [f"### {'PASS' if proc.returncode == 0 else 'FAIL'} · {label}", "", "```text", output[-5000:] or "(no output)", "```", ""]
    return proc.returncode


STALE_PATTERNS = [
    "Onboarding gave you a plan",
    "onboarding gave you a plan",
    "Onboarding gave you a baseline",
    "onboarding gave you a baseline",
    "the baseline you just entered",
    "The walkthrough enters it all",
    "the walkthrough enters it all",
    "as you go through onboarding so you don't miss",
    "The wizard has 13 steps",
    "1/13 · Privacy",
    "The onboarding finale runs 300",
    "You should already have at least one event from onboarding",
    "run your own confidence ring for the first time in the walkthrough at the end of this module",
    "Complete Orange Plan onboarding with your baseline inputs",
]


def stale_audit() -> list[str]:
    files = [ROOT / "MASTER-COURSE.md", ROOT / "MODULE-CHECKPOINTS.md", ROOT / "CIRCLE-STRUCTURE.md"]
    files += sorted((ROOT / "scripts").glob("*.md"))
    files += sorted((ROOT / "lesson-text").glob("*.md"))
    files += sorted((ROOT / "modules").glob("*.md"))
    hits: list[str] = []
    for path in files:
        text = read(path)
        for phrase in STALE_PATTERNS:
            if phrase not in text:
                continue
            for line_number, line in enumerate(text.splitlines(), start=1):
                if phrase in line:
                    hits.append(f"- `{path.relative_to(ROOT)}:{line_number}` — `{phrase}`")
    return hits


def main() -> None:
    patch_master()
    patch_protected_scripts()
    patch_lesson_text()
    patch_walkthrough_scripts()
    patch_checkpoints()
    patch_ai_facts()
    patch_handoff()
    patch_advanced()
    patch_usability_test()

    log = [
        "# Course plan-lifecycle revision report",
        "",
        "## Locked implementation",
        "",
        "- Ten-module order retained.",
        "- Lessons 1.4 and 1.5 retained as two published lessons from one recording.",
        "- Onboarding is a rough estimate, not the baseline.",
        "- Data entry is distributed to the module that owns it.",
        "- Full 1,000-run confidence check moved to Module 9.",
        "- Austin's 1.1 and 1.2 dictation incorporated.",
        "",
        "## Generation and checks",
        "",
    ]

    required = [
        ("build module gates", ["python3", "tools/build-module-gates.py"]),
        ("build scripts", ["python3", "tools/build-scripts.py"]),
        ("build one-file", ["python3", "tools/build-onefile.py"]),
        ("split modules", ["python3", "tools/split-modules.py"]),
        ("build Circle structure", ["python3", "tools/build-circle-structure.py"]),
        ("build dictation order", ["python3", "tools/build-dictation-order.py"]),
        ("build film order", ["python3", "tools/build-film-order.py"]),
        ("build shoot list", ["python3", "tools/build-shoot-list.py"]),
        ("build production checklist", ["python3", "tools/build-production-checklist.py"]),
        ("update metrics", ["python3", "tools/course-metrics.py"]),
    ]
    for label, command in required:
        run_required(label, command, log)

    checks = [
        ("check crossrefs", ["python3", "tools/check-crossrefs.py"]),
        ("check metrics", ["python3", "tools/course-metrics.py", "--check"]),
        ("check visuals", ["python3", "tools/check-visuals.py"]),
        ("check layer parity", ["python3", "tools/check-layer-parity.py"]),
        ("slop scan", ["python3", "tools/slop-scan.py", "--all"]),
    ]
    failed_checks = []
    for label, command in checks:
        if run_check(label, command, log) != 0:
            failed_checks.append(label)

    hits = stale_audit()
    log += ["## Stale onboarding-language audit", ""]
    log += hits or ["No blocked stale phrases remain in the live core layers."]
    log += ["", "## Follow-up", ""]
    if failed_checks:
        log.append("The revision was generated, but these repository gates need a final editorial pass: " + ", ".join(failed_checks) + ".")
    else:
        log.append("All repository gates passed.")
    write(REPORT, "\n".join(log))


if __name__ == "__main__":
    main()
